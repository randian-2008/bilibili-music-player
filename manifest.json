{
    "manifest_version": 3,
    "name": "B站听歌列表",
    "version": "2.8.2",
    "minimum_chrome_version": "109",
    "description": "浏览器级B站后台音频播放器：自带播放列表，关闭网页也能继续听歌。",
    "permissions": [
        "storage",
        "offscreen",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "https://rss.applemarketingtools.com/*",
        "https://c.y.qq.com/*",
        "https://music.163.com/*",
        "*://api.bilibili.com/*",
        "*://*.bilibili.com/*",
        "*://*.bilivideo.com/*",
        "*://*.bilivideo.cn/*",
        "*://*.hdslb.com/*"
    ],
    "background": {
        "service_worker": "src/background/background.js"
    },
    "action": {
        "default_title": "B站听歌列表"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "src/shared/theme.js",
                "src/shared/logger.js",
                "src/content/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "commands": {
        "toggle-panel": {
            "suggested_key": {
                "default": "Ctrl+Shift+B",
                "mac": "Command+Shift+B"
            },
            "description": "显示/隐藏听歌列表面板"
        }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "src/panel/sidepanel.html",
                "src/panel/sidepanel.js",
                "src/panel/sidepanel.css",
                "src/shared/theme.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "referer",
                "enabled": true,
                "path": "src/network/rules.json"
            }
        ]
    },
    "icons": {
        "16": "assets/icons/icon16.png",
        "48": "assets/icons/icon48.png",
        "128": "assets/icons/icon128.png"
    }
}
